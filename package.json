{
  "name": "nvector-geodesy",
  "version": "0.0.0",
  "description": "Functions for performing geographical position calculations using n-vectors",
  "keywords": [
    "distance",
    "geodesy",
    "geodetic",
    "geodesic",
    "geography",
    "nvector",
    "vector",
    "wgs84"
  ],
  "repository": "ezzatron/nvector-js",
  "bugs": "https://github.com/ezzatron/nvector-js/issues",
  "homepage": "https://ezzatron.com/nvector-js",
  "author": "Erin Millard <contact@erin.id.au>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "artifacts/dist/index.js",
  "types": "artifacts/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./artifacts/dist/index.d.ts",
      "import": "./artifacts/dist/index.js",
      "default": "./artifacts/dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "/artifacts/dist/"
  ],
  "scripts": {
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "overrides": {
    "@fast-check/vitest": {
      "vitest": "$vitest"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@eslint/js": "^10.0.1",
    "@fast-check/vitest": "^0.5.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@skypack/package-check": "^0.2.2",
    "@types/ws": "^8.5.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/eslint-plugin": "^1.6.22",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-n": "^18.2.1",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.3 <3.9.7",
    "prettier-plugin-organize-imports": "^4.0.0",
    "publint": "^0.3.0",
    "size-limit": "^14.0.0",
    "testcontainers": "^12.1.0",
    "typedoc": "^0.28.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^5.0.0",
    "ws": "^8.14.2"
  }
}
